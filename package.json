{
  "name": "@ds-plugins/dsh-adaptive-scheduler",
  "version": "0.3.0",
  "description": "Bounded adaptive route selection and escalation for DeepSeek Harness",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "main": "./lib/src/index.js",
  "types": "./lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    }
  },
  "files": [
    "lib/src",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:package-entry": "pnpm run build && pnpm exec vitest run tests/package-entry.spec.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@ds-plugins/dsh-scheduling-contracts": "^0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@ds-plugins/dsh-scheduling-contracts": "^0.3.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
